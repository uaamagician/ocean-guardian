rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidLocation(loc) {
      return loc is map
        && loc.keys().hasOnly(["lat", "lng"])
        && loc.keys().hasAll(["lat", "lng"])
        && loc.lat is number && loc.lat >= -90 && loc.lat <= 90
        && loc.lng is number && loc.lng >= -180 && loc.lng <= 180;
    }

    function isOwnPhotoPath(path) {
      return path is string && path.matches("reports/" + request.auth.uid + "/[^/]+");
    }

    // Rules have no loops, so each of the (at most 4) entries is checked explicitly.
    function isValidPhotos(photos) {
      return photos is list
        && photos.size() >= 1 && photos.size() <= 4
        && isOwnPhotoPath(photos[0])
        && (photos.size() < 2 || isOwnPhotoPath(photos[1]))
        && (photos.size() < 3 || isOwnPhotoPath(photos[2]))
        && (photos.size() < 4 || isOwnPhotoPath(photos[3]));
    }

    match /reports/{reportId} {
      allow read: if resource.data.status == "published"
        || (request.auth != null && resource.data.reporterId == request.auth.uid);

      // aiAnalysis and the final status are written only by the analyzeReport
      // function through the Admin SDK, which bypasses these rules.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(["type", "photos", "location", "reporterId", "createdAt", "status"])
        && request.resource.data.keys().hasAll(["type", "photos", "location", "reporterId", "createdAt", "status"])
        && request.resource.data.type in ["trash", "coral"]
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == "processing"
        && request.resource.data.createdAt == request.time
        && isValidPhotos(request.resource.data.photos)
        && isValidLocation(request.resource.data.location);

      allow update, delete: if false;
    }

    // Beaches people add themselves, often spots that aren't tourist beaches.
    match /beaches/{beachId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(["name", "kind", "notes", "location", "createdBy", "createdAt"])
        && request.resource.data.keys().hasAll(["name", "kind", "notes", "location", "createdBy", "createdAt"])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.kind in ["sand", "pebble", "rock", "mixed", "unknown"]
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 280
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && isValidLocation(request.resource.data.location);
      allow update, delete: if false;
    }

    // Written only by the planCleanup function (Admin SDK); anyone can read a plan.
    match /cleanupPlans/{beachId} {
      allow read: if true;
      allow write: if false;
    }

    // Cleanup events. The work order is a copy of the AI plan at creation time.
    match /events/{eventId} {
      function isOpenEvent() {
        let e = get(/databases/$(database)/documents/events/$(eventId)).data;
        return e.status == "open" && e.startsAt > request.time;
      }
      function isOrganizer() {
        return request.auth != null
          && get(/databases/$(database)/documents/events/$(eventId)).data.createdBy == request.auth.uid;
      }

      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(["beachId", "beachName", "location", "title", "startsAt", "durationHours", "meetingPoint", "organizer", "description", "capacity", "workOrder", "createdBy", "createdAt", "status"])
        && request.resource.data.keys().hasAll(["beachId", "beachName", "location", "title", "startsAt", "durationHours", "meetingPoint", "organizer", "description", "capacity", "workOrder", "createdBy", "createdAt", "status"])
        && request.resource.data.beachId is string && request.resource.data.beachId.size() <= 100
        && request.resource.data.beachName is string && request.resource.data.beachName.size() <= 120
        && isValidLocation(request.resource.data.location)
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 100
        && request.resource.data.startsAt is timestamp && request.resource.data.startsAt > request.time
        && request.resource.data.durationHours is number
        && request.resource.data.durationHours >= 0.5 && request.resource.data.durationHours <= 12
        && request.resource.data.meetingPoint is string && request.resource.data.meetingPoint.size() <= 200
        && request.resource.data.organizer is map
        && request.resource.data.organizer.keys().hasOnly(["name", "type"])
        && request.resource.data.organizer.name is string
        && request.resource.data.organizer.name.size() >= 2 && request.resource.data.organizer.name.size() <= 80
        && request.resource.data.organizer.type in ["individual", "school", "ngo", "company"]
        && request.resource.data.description is string && request.resource.data.description.size() <= 1000
        && request.resource.data.capacity is int
        && request.resource.data.capacity >= 1 && request.resource.data.capacity <= 500
        && request.resource.data.workOrder is map
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == "open";
      // The organizer can only cancel; everything else is fixed once people have signed up.
      allow update: if request.auth != null
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && request.resource.data.status == "cancelled";
      allow delete: if false;

      // One sign-up per person, keyed by uid. Names and group sizes are public.
      match /signups/{uid} {
        allow read: if true;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && isOpenEvent()
          && request.resource.data.keys().hasOnly(["name", "groupSize", "bringing", "note", "createdAt"])
          && request.resource.data.keys().hasAll(["name", "groupSize", "bringing", "note", "createdAt"])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
          && request.resource.data.groupSize is int
          && request.resource.data.groupSize >= 1 && request.resource.data.groupSize <= 10
          && request.resource.data.bringing is list && request.resource.data.bringing.size() <= 13
          && request.resource.data.note is string && request.resource.data.note.size() <= 200
          && (resource == null
            ? request.resource.data.createdAt == request.time
            : request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      // Contact details are private: only the person and the organizer can read them.
      match /contacts/{uid} {
        allow read: if request.auth != null && (request.auth.uid == uid || isOrganizer());
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["contact"])
          && request.resource.data.contact is string
          && request.resource.data.contact.size() >= 3 && request.resource.data.contact.size() <= 120;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
