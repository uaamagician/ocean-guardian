rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /reports/{uid}/{fileName} {
      allow read: if true;
      // resource == null blocks overwrites; an overwrite could swap the photo
      // after the AI has already analyzed and published it.
      allow create: if request.auth != null
        && resource == null
        && request.auth.uid == uid
        // A report's photos (up to 4) go into one Gemini request (~20MB limit
        // incl. base64 overhead), so the frontend must downscale before uploading.
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)');
      allow update, delete: if false;
    }

    // Photos an organizer takes after a cleanup. Anyone signed in with Google
    // may upload to their own folder; only the organizer can attach them to
    // the event (Firestore rules check the paths), so stray uploads go nowhere.
    match /events/{eventId}/{uid}/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && resource == null
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update, delete: if false;
    }
  }
}
